{
  "version": "1.0.0",
  "asr_triggers": {
    "sensitive_paths": [
      "sync.py",
      "restore_skills.py",
      "deploy_skills.py",
      "update_readme.py",
      "debug_scan.py",
      "audit_status.json",
      "docs/architecture.md",
      "skills/config-skills/**",
      "infra/**",
      "terraform/**",
      "k8s/**"
    ],
    "architectural_keywords": [
      "BREAKING CHANGE",
      "deprecate",
      "protocol change",
      "database migration",
      "auth provider",
      "encryption",
      "microservice",
      "zero trust",
      "taxonomy",
      "restructure"
    ],
    "thresholds": {
      "max_unreviewed_core_loc": 250,
      "require_adr_for_new_services": true,
      "require_adr_for_schema_changes": true
    }
  },
  "adr_directory": "docs/adr",
  "index_file": "docs/adr/adr_index.json"
}
